// Decimal to Binary
#include<stdio.h>
void convertDecimalToBinary(int n){
    int binaryNum[100], i = 0;
    while(n != 0){
        binaryNum[i] = n % 2;
        n = n / 2;
        i++;
    }
    printf("Binary: ");
    for(int j = i - 1; j >= 0; j--){
        printf("%d", binaryNum[j]);
    }
    printf("\n");
}
int main(){
    int n;
    printf("Enter a decimal number: ");
    scanf("%d", &n);
    convertDecimalToBinary(n);
    return 0;
}
